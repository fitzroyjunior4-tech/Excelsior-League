rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read (viewers see everything without logging in),
    // admin-only write (only your signed-in Firebase Auth account).
    match /teams/{docId}    { allow read: if true; allow write: if request.auth != null; }
    match /players/{docId}  { allow read: if true; allow write: if request.auth != null; }
    match /fixtures/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /news/{docId}     { allow read: if true; allow write: if request.auth != null; }
    match /config/{docId}   { allow read: if true; allow write: if request.auth != null; }
  }
}
